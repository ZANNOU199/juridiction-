{
  "entities": {
    "Competition": {
      "title": "Competition Settings",
      "description": "Global settings for the competition",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "juryCount": { "type": "number" },
        "currentMatchId": { "type": "string" },
        "configured": { "type": "boolean" }
      },
      "required": ["name", "juryCount", "configured"]
    },
    "Participant": {
      "title": "Participant",
      "description": "A battle participant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photo": { "type": "string" }
      },
      "required": ["name"]
    },
    "Match": {
      "title": "Match",
      "description": "A battle match",
      "type": "object",
      "properties": {
        "redTeamId": { "type": "string" },
        "blueTeamId": { "type": "string" },
        "redVotes": { "type": "number" },
        "blueVotes": { "type": "number" },
        "winnerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "finished"] },
        "round": { "type": "string" },
        "votingMode": { "type": "string", "enum": ["match", "round"] },
        "roundCount": { "type": "number" },
        "currentRound": { "type": "number" },
        "roundResults": { "type": "array" },
        "finishedJuries": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["redTeamId", "blueTeamId", "status", "order"]
    },
    "Vote": {
      "title": "Vote",
      "description": "A jury vote for a match",
      "type": "object",
      "properties": {
        "juryId": { "type": "string" },
        "matchId": { "type": "string" },
        "roundIndex": { "type": "number" },
        "vote": { "type": "string", "enum": ["red", "blue"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["juryId", "matchId", "vote"]
    }
  },
  "firestore": {
    "/settings/competition": {
      "schema": "Competition",
      "description": "Global competition settings"
    },
    "/participants/{participantId}": {
      "schema": "Participant",
      "description": "List of all participants"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "List of all matches"
    },
    "/matches/{matchId}/votes/{voteId}": {
      "schema": "Vote",
      "description": "Votes cast for a specific match"
    }
  }
}
