rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Singleton tournament state document access
    // This allows our server/backend APIs to load and store tournament state securely.
    match /state/current {
      allow read, write: if true;
    }
  }
}
